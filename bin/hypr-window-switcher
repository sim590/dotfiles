#!/bin/bash
# Commutateur de fenêtres Hyprland via rofi (remplace swayr switch-window).
selected=$(hyprctl clients -j | jq -r '.[] | "\(.address) [\(.workspace.name)] \(.class): \(.title)"' | /usr/bin/rofi -dmenu -i -p "Fenêtre")
if [ -n "$selected" ]; then
    addr=$(echo "$selected" | awk '{print $1}')
    hyprctl dispatch focuswindow "address:$addr"
fi
