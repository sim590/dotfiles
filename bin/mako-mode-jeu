#!/usr/bin/env bash

# Surveillance du mode plein écran pour activer/désactiver le mode « jeu »
# de mako. Quand une fenêtre est en plein écran, les notifications sont
# redirigées vers le moniteur secondaire.
#
# Supporte Sway et Hyprland.

PIDFILE="${XDG_RUNTIME_DIR}/mako-mode-jeu.pid"

# Vérifier si une instance roule déjà
if [[ -f "$PIDFILE" ]]; then
    old_pid=$(cat "$PIDFILE")
    if kill -0 "$old_pid" 2>/dev/null; then
        echo "mako-mode-jeu roule déjà (PID $old_pid). On quitte." >&2
        exit 0
    fi
fi

# Écrire notre PID
echo $$ > "$PIDFILE"

# Nettoyer à la sortie
trap 'rm -f "$PIDFILE"; makoctl mode -r jeu 2>/dev/null' EXIT

# Détecter le compositeur
if [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
    COMPOSITOR=hyprland
elif [[ -n "$SWAYSOCK" ]]; then
    COMPOSITOR=sway
else
    echo "Aucun compositeur supporté détecté." >&2
    exit 1
fi

# Vérifie si une fenêtre est en plein écran
est_plein_ecran() {
    if [[ "$COMPOSITOR" = "sway" ]]; then
        local count
        count=$(swaymsg -t get_tree -r | jq '[recurse(.nodes[], .floating_nodes[]) | select(.pid != null and .fullscreen_mode > 0)] | length')
        [[ "$count" -gt 0 ]]
    else
        local count
        count=$(hyprctl clients -j | jq '[.[] | select(.fullscreen == true)] | length')
        [[ "$count" -gt 0 ]]
    fi
}

mettre_a_jour() {
    if est_plein_ecran; then
        if [[ "$mode_actif" = false ]]; then
            makoctl mode -a jeu
            mode_actif=true
            echo "$(date +%H:%M:%S) Mode jeu activé"
        fi
    else
        if [[ "$mode_actif" = true ]]; then
            makoctl mode -r jeu
            mode_actif=false
            echo "$(date +%H:%M:%S) Mode jeu désactivé"
        fi
    fi
}

mode_actif=false

# Vérifier l'état initial
mettre_a_jour

echo "Surveillance du mode plein écran démarrée ($COMPOSITOR)..."

if [[ "$COMPOSITOR" = "sway" ]]; then
    swaymsg -t subscribe -m '["window"]' | while read -r window_json; do
        window_event=$(echo "$window_json" | jq -r '.change')
        if [[ "$window_event" = "fullscreen_mode" || "$window_event" = "close" || "$window_event" = "focus" ]]; then
            mettre_a_jour
        fi
    done
else
    # Hyprland : socat sur le socket d'événements
    socat -U - "UNIX-CONNECT:${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket2.sock" | while read -r line; do
        event="${line%%>>*}"
        if [[ "$event" = "fullscreen" || "$event" = "closewindow" || "$event" = "activewindow" ]]; then
            mettre_a_jour
        fi
    done
fi
