#!/usr/bin/env bash

# Navigue vers l'espace de travail occupé suivant ou précédent sur le
# moniteur courant. Saute les espaces vides.
#
# Usage : hypr-cycle-workspace next|prev

direction="$1"

# Récupérer le moniteur et l'espace actif
active_json=$(hyprctl activeworkspace -j)
active_id=$(echo "$active_json" | jq '.id')
active_monitor=$(echo "$active_json" | jq -r '.monitor')

# Lister les espaces occupés sur ce moniteur, triés par ID
occupied=$(hyprctl workspaces -j | jq -r --arg mon "$active_monitor" \
    '[.[] | select(.monitor == $mon and .windows > 0) | .id] | sort')

count=$(echo "$occupied" | jq 'length')

# Trouver l'index de l'espace actif
current_idx=$(echo "$occupied" | jq --argjson id "$active_id" 'to_entries | .[] | select(.value == $id) | .key')

if [ -z "$current_idx" ]; then
    # L'espace actif est vide — il faut au moins un espace occupé
    if [ "$count" -lt 1 ]; then
        exit 0
    fi
    # L'espace actif est vide — aller au plus proche dans la direction demandée
    if [ "$direction" = "next" ]; then
        target=$(echo "$occupied" | jq --argjson id "$active_id" \
            '[.[] | select(. > $id)] | if length > 0 then .[0] else empty end')
    else
        target=$(echo "$occupied" | jq --argjson id "$active_id" \
            '[.[] | select(. < $id)] | if length > 0 then .[-1] else empty end')
    fi
    [ -z "$target" ] && exit 0
else
    if [ "$direction" = "next" ]; then
        next_idx=$(( current_idx + 1 ))
        if [ "$next_idx" -ge "$count" ]; then
            exit 0  # pas de bouclage
        fi
        target=$(echo "$occupied" | jq ".[$next_idx]")
    else
        prev_idx=$(( current_idx - 1 ))
        if [ "$prev_idx" -lt 0 ]; then
            exit 0  # pas de bouclage
        fi
        target=$(echo "$occupied" | jq ".[$prev_idx]")
    fi
fi

hyprctl dispatch workspace "$target"
