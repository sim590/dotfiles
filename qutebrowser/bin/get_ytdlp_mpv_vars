#!/usr/bin/env bash

URL="$1"
URL_HOSTNAME=$(echo $URL | sed 's,^.*https\?://\([^/]\+\)/.*,\1,')

ytdlp_hosts_list=(
  "youtube.com"
  "www.youtube.com"
)

USE_YTDLP_FOR_DOWNLOAD=no
if [[ "${ytdlp_hosts_list[@]}" =~ "$URL_HOSTNAME" ]]; then
  USE_YTDLP_FOR_DOWNLOAD=yes
fi

function init_ytdlp_mpv() {
  MPV_FLAGS="--force-window --no-terminal --keep-open=yes --demuxer-max-back-bytes=12G --demuxer-donate-buffer=no"
  if ! [[ $USE_YTDLP_FOR_DOWNLOAD = "yes" ]]; then
    MPV_FLAGS="$MPV_FLAGS --ytdl --ytdl-format=bestvideo*[height<=?1440]+bestaudio/best"
  fi

  EXTRACTOR_FLAG="--extractor-arg youtube:player_client=web_safari"
  COOKIES_FLAG="--cookies-from-browser chromium:~/.local/share/qutebrowser"
  YT_DLP_FLAGS="$COOKIES_FLAG $EXTRACTOR_FLAG -N 8 --downloader=http --format=bestvideo*[height<=?1440]"
  YT_DLP_AUDIO_FLAGS="$COOKIES_FLAG $EXTRACTOR_FLAG --downloader=aria2c -f 'bestaudio[language=fr],bestaudio'"

  export USE_YTDLP_FOR_DOWNLOAD YT_DLP_FLAGS MPV_FLAGS
}

